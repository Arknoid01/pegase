<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Suites de diagnostic déclenchées par adb (am broadcast -n …/.diag.DiagSuiteReceiver).
             Debug uniquement : exporté sans permission, il ne doit pas exister en release. -->
        <receiver
            android:name="com.pegasuscorp.orbe.diag.DiagSuiteReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.pegasuscorp.orbe.action.RUN_DIAG_SUITE" />
            </intent-filter>
        </receiver>

        <!-- Phrase de test envoyée à Pégase comme si elle était tapée dans la discussion
             (am broadcast -n …/.diag.DebugChatReceiver avec l'extra « text »).
             Debug uniquement, même raison que ci-dessus. -->
        <receiver
            android:name="com.pegasuscorp.orbe.diag.DebugChatReceiver"
            android:exported="true"
            android:enabled="true" />

        <!-- Relais LLM pour les bancs du PC : Orbe appelle Groq avec SA clé (jamais transmise).
             Protégé par DUMP : seul le shell adb peut le déclencher, pas les autres applis. -->
        <receiver
            android:name="com.pegasuscorp.orbe.diag.DebugLlmRelayReceiver"
            android:exported="true"
            android:enabled="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
