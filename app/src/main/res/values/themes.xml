<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Orbe" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Fond opaque : Fluid + voile par-dessus (plus de wallpaper système visible). -->
        <item name="android:windowBackground">@color/orbe_window_bg</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>

        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- Dialogs sombres (lecture fichiers, mémoire, etc.) -->
    <style name="Theme.Orbe.DarkDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:background">#FF0B0E14</item>
        <item name="colorSurface">#FF0B0E14</item>
        <item name="android:colorBackground">#FF0B0E14</item>
        <item name="android:windowBackground">#FF0B0E14</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B3FFFFFF</item>
        <item name="colorOnSurface">#FFFFFF</item>
    </style>

    <!-- Aperçu NASA par-dessus l'app -->
    <style name="Theme.Orbe.Preview" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.7</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <!-- Wake in-place : transparent AppCompat (remplace Theme.Translucent.NoTitleBar). -->
    <style name="Theme.Orbe.Translucent" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Menus ⋮ interface Pégase — slide + fond assombri -->
    <style name="Theme.Orbe.BottomSheet" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:navigationBarColor">#1A1A1A</item>
        <item name="bottomSheetStyle">@style/Widget.Orbe.BottomSheet</item>
    </style>

    <style name="Widget.Orbe.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="behavior_skipCollapsed">true</item>
        <item name="behavior_fitToContents">true</item>
    </style>

    <!-- Bureau Markdown : fond sombre, barres système opaques (pas translucides). -->
    <style name="Theme.Orbe.Bureau" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">#0B0E14</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:statusBarColor">#0B0E14</item>
        <item name="android:navigationBarColor">#0B0E14</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="colorPrimary">#5B8DEF</item>
        <item name="colorPrimaryVariant">#3D6BC7</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">#5B8DEF</item>
        <item name="colorSecondaryVariant">#3D6BC7</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">#141A22</item>
        <item name="android:colorBackground">#0B0E14</item>
    </style>

    <!-- Interface Pégase : fond home, accent cyan (pas le violet Material template). -->
    <style name="Theme.Orbe.Pegase" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/orbe_window_bg</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:statusBarColor">@color/orbe_window_bg</item>
        <item name="android:navigationBarColor">@color/orbe_window_bg</item>
        <item name="colorPrimary">@color/orbe_cyan</item>
        <item name="colorPrimaryVariant">@color/orbe_cyan_edge</item>
        <item name="colorOnPrimary">@color/orbe_window_bg</item>
        <item name="colorSecondary">@color/orbe_cyan</item>
        <item name="colorSecondaryVariant">@color/orbe_cyan_edge</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/orbe_card</item>
        <item name="android:colorBackground">@color/orbe_window_bg</item>
        <item name="android:windowAnimationStyle">@style/Animation.Orbe.Pegase</item>
    </style>

    <style name="Animation.Orbe.Pegase" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/pegase_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/pegase_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/pegase_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/pegase_exit</item>
    </style>
</resources>