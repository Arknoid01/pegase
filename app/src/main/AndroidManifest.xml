<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Pour lister / lancer les apps du tiroir. Sur Android 11+ (API 30),
         il faut declarer les intents qu'on veut "voir". -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.anddoes.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.teslacoilsw.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.gau.go.launcherex.theme" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="org.adw.launcher.icons.ACTION_PICK_ICON" />
        </intent>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_PICK" />
        </intent>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_BIND" />
        </intent>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.item/event" />
        </intent>
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.waze" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Orbe">

        <!-- MainActivity = l'ecran d'accueil. Les 3 categories/flags ci-dessous
             sont ce qui fait qu'Android la propose comme launcher. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="false"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".SpotifyAuthActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.pegasuscorp.orbe"
                    android:host="spotify-callback" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.Orbe" />

        <activity
            android:name=".WidgetBoardActivity"
            android:exported="false"
            android:theme="@style/Theme.Orbe" />

        <activity
            android:name=".bureau.BureauActivity"
            android:exported="false"
            android:theme="@style/Theme.Orbe.Bureau"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".bureau.BureauPlanningActivity"
            android:exported="false"
            android:theme="@style/Theme.Orbe.Bureau"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <activity
            android:name=".PegaseInterfaceActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Orbe.Pegase"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <!-- Deep link Assistant / routines : pegase://open[/conversation|orion] -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pegase" android:host="open" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ChatTestActivity"
            android:exported="false"
            android:theme="@style/Theme.Orbe"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ApiSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Orbe"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AtlasSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Orbe"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PortraitActivity"
            android:exported="false"
            android:theme="@style/Theme.Orbe.Pegase" />

        <activity
            android:name=".MemorySettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Orbe"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SpeechRulesSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Orbe"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".VoiceCorrectionsSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Orbe"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".KnowMeSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Orbe"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".RoutingLearningActivity"
            android:exported="false"
            android:theme="@style/Theme.Orbe"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".RoutineSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Orbe"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".OrionSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Orbe"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SpeakerEnrollmentActivity"
            android:exported="false"
            android:theme="@style/Theme.Orbe"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".NasaImagePreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.Orbe.Preview"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity="com.pegasuscorp.orbe.nasa_preview" />

        <activity
            android:name=".orion.OrionPagePreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.Orbe"
            android:excludeFromRecents="true"
            android:launchMode="singleTop" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".voice.VoiceService"
            android:exported="false"
            android:process=":voice"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name=".notepad.NotepadReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".prefetch.PrefetchAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".prefetch.PrefetchBootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".intentions.IntentionActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".learning.LearningActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".intentions.IntentionScheduler$IntentionTickReceiver"
            android:exported="false" />

        <receiver
            android:name=".f1companion.F1NewsScheduler$NewsTickReceiver"
            android:exported="false" />

        <receiver
            android:name=".f1companion.F1LiveScheduler$LiveTickReceiver"
            android:exported="false" />

        <activity
            android:name=".copilot.ShareIngestActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Pégase — mémoriser"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".copilot.PegaseAccessibilityService"
            android:exported="false"
            android:label="Pégase copilote"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/pegase_accessibility_config" />
        </service>

        <service
            android:name=".copilot.CopilotService"
            android:exported="false"
            android:process=":copilot"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="copilot_screen_analysis" />
        </service>

        <service
            android:name=".copilot.TranslationOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="copilot_translation_overlay" />
        </service>

        <activity
            android:name=".copilot.CopilotSettingsActivity"
            android:exported="false"
            android:label="Mode copilote"
            android:theme="@style/Theme.Orbe" />

        <service
            android:name=".FloatingOrbService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_orb_overlay" />
        </service>

        <activity
            android:name=".copilot.ScreenCapturePermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".PegaseNotificationListenerService"
            android:exported="true"
            android:label="Pégase — notifications"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
