# Source unique — chemins sync Google Drive (PC + app Android SAF).
# Installé dans /etc/pegase/ par install-pegase-sync-drive-notepad.sh
#
# Arborescence (PAS de sous-dossier "sync" intermédiaire) :
#   ${PEGASE_DRIVE}/${PEGASE_DRIVE_FOLDER}/android-<deviceId>/op-NNNNNN.json  ← export téléphone
#   ${PEGASE_DRIVE}/${PEGASE_DRIVE_FOLDER}/${PEGASE_PC_DEVICE_ID}/op-NNNNNN.json ← export PC
#
# Sens de sync :
#   tel → PC : script pegase-sync-drive-notepad.sh lit android-*/ (import local)
#   PC → tel : app Android lit ${PEGASE_PC_DEVICE_ID}/ via SAF (Synchroniser maintenant)
#
# Doit correspondre à com.pegasuscorp.orbe.sync.DriveSyncLayout (Android).

PEGASE_DRIVE_FOLDER=Pegase
PEGASE_PC_DEVICE_ID=pc-pegase-arch
